SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Почта: console backend печатает письма в терминал.
MAILER_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@mail-service.local

# Регистрация
EMAIL_CONFIRMATION_TIMEOUT_HOURS=72

# Кеширование
CACHE_TIMEOUT=300
